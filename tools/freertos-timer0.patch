diff --git a/portable/ThirdParty/GCC/ATmega/portmacro.h b/portable/ThirdParty/GCC/ATmega/portmacro.h
index 0cc5834..8889034 100644
--- a/portable/ThirdParty/GCC/ATmega/portmacro.h
+++ b/portable/ThirdParty/GCC/ATmega/portmacro.h
@@ -98,9 +98,22 @@ typedef uint8_t        UBaseType_t;
 
 /* System Tick  - Scheduler timer
  * Prefer to use the enhanced Watchdog Timer, but also Timer0 is ok.
+ *
+ * Local modification (stepper-interface): FreeRTOSConfig.h may set
+ * configAVR_USE_TIMER0_TICK to 1. That selects Timer0 and leaves the
+ * watchdog disabled, which keeps an Arduino Mega USB bootloader reachable
+ * after a crash. Leaving the macro unset preserves the upstream choice.
  */
 
-#if defined( WDIE ) && defined( WDIF ) /* If Enhanced WDT with interrupt capability is available */
+#ifndef configAVR_USE_TIMER0_TICK
+    #define configAVR_USE_TIMER0_TICK    0
+#endif
+
+#if ( configAVR_USE_TIMER0_TICK == 1 )
+
+    #define portUSE_TIMER0
+
+#elif defined( WDIE ) && defined( WDIF ) /* If Enhanced WDT with interrupt capability is available */
 
     #define portUSE_WDTO    WDTO_15MS  /* use the Watchdog Timer for xTaskIncrementTick */
 
